    "Kayıt başlatma komutu alındığında kısa bir onay sesi çalar.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plays a short confirmation sound when the recording start command is received."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt başlatma komutu alındığında kısa bir onay sesi çalar."
          }
        }
      }
    },
    "Hazırlık veya geri sayım bittikten sonra, kayıt gerçekten başlamadan hemen önce başlangıç sesi çalar.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plays the start sound after preparation or countdown, just before recording actually begins."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hazırlık veya geri sayım bittikten sonra, kayıt gerçekten başlamadan hemen önce başlangıç sesi çalar."
          }
        }
      }
    },
    "Kayıt durduktan sonra bitiş sesi çalar.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plays the finish sound after the recording stops."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt durduktan sonra bitiş sesi çalar."
          }
        }
      }
    },
    "Kayıt duraklatıldığında veya devam ettirildiğinde geçiş sesi çalar.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plays a transition sound when recording is paused or resumed."
          }
        },
