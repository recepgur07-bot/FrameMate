        "tr": { "stringUnit": { "state": "translated", "value": "Bu ayki ücretsiz süre bitti" } }
      }
    },
    "Planları görmek için etkinleştir.": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Activate to view plans." } },
        "tr": { "stringUnit": { "state": "translated", "value": "Planları görmek için etkinleştir." } }
      }
    },
    "Üçten fazla kişi görünüyor, en öne çıkan üç kişiye göre yönlendiriliyor": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "More than three people are visible, guidance is based on the three most prominent people"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üçten fazla kişi görünüyor, en öne çıkan üç kişiye göre yönlendiriliyor"
          }
        }
      }
    },
    "Kayıt süresini düzenli olarak hatırlat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remind me of recording duration regularly"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt süresini düzenli olarak hatırlat"
          }
        }
      }
    },
    "Kayıt sırasında ne kadar süre geçtiğini belirli aralıklarla hatırlatır. Dahili mikrofonla kayıt yaparken bu hatırlatma hoparlörden duyulup mikrofona karışabilir; kulaklık kullanman veya bunu kapatman bunu önler.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminds you at regular intervals how long the recording has been running. When recording with the built-in microphone, this reminder can be heard through the speakers and picked up by the microphone; using headphones or turning this off prevents that."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt sırasında ne kadar süre geçtiğini belirli aralıklarla hatırlatır. Dahili mikrofonla kayıt yaparken bu hatırlatma hoparlörden duyulup mikrofona karışabilir; kulaklık kullanman veya bunu kapatman bunu önler."
          }
        }
      }
    },
    "Hatırlatma şekli": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminder style"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hatırlatma şekli"
          }
        }
      }
    },
    "Sesli okuma, süreyi VoiceOver ile söyler. Ses efekti, yalnızca kısa bir tık sesi çalar; hoparlörden mikrofona karışması daha az fark edilir.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voice announcement speaks the duration via VoiceOver. Sound effect plays only a short tick sound; it is less noticeable if it bleeds from the speakers into the microphone."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesli okuma, süreyi VoiceOver ile söyler. Ses efekti, yalnızca kısa bir tık sesi çalar; hoparlörden mikrofona karışması daha az fark edilir."
          }
        }
      }
    },
