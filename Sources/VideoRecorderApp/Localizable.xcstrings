        "tr": { "stringUnit": { "state": "translated", "value": "Yıllık abonelik. Sınırsız kayıt ve tüm Pro özellikleri açar." } }
      }
    },
    "Bu ayki ücretsiz kayıt süreniz bitti. Yeni kota bir sonraki ay başında yenilenecek.": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Your free recording time for this month has ended. Your new quota will renew at the start of next month." } },
        "tr": { "stringUnit": { "state": "translated", "value": "Bu ayki ücretsiz kayıt süreniz bitti. Yeni kota bir sonraki ay başında yenilenecek." } }
      }
    },
    "Zaten her ay 7 dakika ücretsiz kayıt hakkın var. Sınırsız kayıt, gelişmiş kadraj koçu ve tüm özellikler için:": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "You already have 7 minutes of free recording each month. For unlimited recording, advanced Frame Coach, and all features:" } },
        "tr": { "stringUnit": { "state": "translated", "value": "Zaten her ay 7 dakika ücretsiz kayıt hakkın var. Sınırsız kayıt, gelişmiş kadraj koçu ve tüm özellikler için:" } }
      }
    },
    "Nasıl Çalışır?": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "How It Works" } },
        "tr": { "stringUnit": { "state": "translated", "value": "Nasıl Çalışır?" } }
      }
    },
    "İlk 3 gün sınırsız kayıt yapabilirsin, hiçbir hesap gerekmez. Sonrasında her ay 7 dakika ücretsiz kaydın olur — süre dolunca bir sonraki ay otomatik yenilenir. İstediğin an Pro'ya geçip sınırsız kullanabilirsin.": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Record without limits for your first 3 days, with no account required. After that, you get 7 free recording minutes each month, renewing automatically at the start of the next month. Upgrade to Pro anytime for unlimited access." } },
        "tr": { "stringUnit": { "state": "translated", "value": "İlk 3 gün sınırsız kayıt yapabilirsin, hiçbir hesap gerekmez. Sonrasında her ay 7 dakika ücretsiz kaydın olur — süre dolunca bir sonraki ay otomatik yenilenir. İstediğin an Pro'ya geçip sınırsız kullanabilirsin." } }
      }
    },
    "Adım 4 / 4: Nasıl Çalışır?": {
      "extractionState": "manual",
      "localizations": {
        "en": { "stringUnit": { "state": "translated", "value": "Step 4 of 4: How It Works" } },
        "tr": { "stringUnit": { "state": "translated", "value": "Adım 4 / 4: Nasıl Çalışır?" } }
      }
    },
