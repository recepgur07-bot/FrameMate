    "NSCameraUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Camera access is used for screen + camera recording and frame preview; for example, to place your face on screen while recording a lesson, demo, or short update video."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kamera, ekran + kamera kaydı ve kadraj önizlemesi için kullanılır; örneğin bir ders, demo veya kısa güncelleme videosu kaydederken yüzünüzü ekrana eklemek için."
          }
        }
      }
    },
    "NSHumanReadableCopyright" : {
      "comment" : "Copyright (human-readable)",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copyright © 2026 Recep Gür. All rights reserved."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Telif hakkı © 2026 Recep Gür. Tüm hakları saklıdır."
          }
        }
      }
    },
    "NSMicrophoneUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Microphone access is used to capture narration for screen recordings and to create voice-only recordings, for example when you record a lesson, demo, meeting notes, or a podcast draft."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mikrofon, ekran kayıtlarına anlatım sesi eklemek ve yalnızca ses kaydı oluşturmak için kullanılır; örneğin bir ders, demo, toplantı notu veya podcast taslağı kaydederken sesinizi almak için."
          }
        }
      }
    },
    "NSScreenCaptureUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Screen Recording permission is required to capture your screen and windows; for example, when recording a product walkthrough or lesson video."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ekran ve pencereleri kaydetmek için ekran yakalama izni gereklidir; örneğin bir ürün anlatımı veya ders videosunda ekrandaki içerik kaydedilir."
          }
        }
      }
    },
    "NSSpeechUsageDescription" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speech synthesis is used to speak Frame Coach guidance aloud; for example, to give live framing cues while recording."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kadraj koçluğu yönergelerini sesli olarak duyurmak için ses sentezi kullanılır; örneğin kayıt sırasında kadrajı ortalamak için anlık yönlendirme verilir."
          }
        }
      }
    }
  },
  "version" : "1.0"
}